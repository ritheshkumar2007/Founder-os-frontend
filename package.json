{
  "name": "founderos-platform",
  "version": "1.0.0",
  "description": "FounderOS - AI-Powered Co-Founder Platform",
  "main": "frontend/backend/src/server.js",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm install && NITRO_PRESET=vercel npm run build && mkdir -p ../.vercel && cp -r .vercel/output ../.vercel/ 2>/dev/null || true",
    "start": "cd frontend/backend && node src/server.js",
    "backend:install": "cd frontend/backend && npm install",
    "backend:dev": "cd frontend/backend && npm run dev",
    "backend:start": "cd frontend/backend && npm start",
    "frontend:install": "cd frontend && npm install",
    "frontend:build": "cd frontend && npm install && NITRO_PRESET=vercel npm run build",
    "frontend:dev": "cd frontend && npm run dev"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "authentication",
    "founderos"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "morgan": "^1.10.0",
    "openai": "^7.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
